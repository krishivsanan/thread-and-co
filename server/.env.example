# Copy this file to .env and fill in your own values. .env is gitignored.

# Local Postgres:
#   DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/threadco
# Hosted Postgres (Neon / Supabase / Render, all have free tiers):
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threadco

# Set to "true" only for hosted providers that require SSL (Neon, Supabase, etc.)
DATABASE_SSL=false

PORT=4000
